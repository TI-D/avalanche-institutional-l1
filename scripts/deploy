#!/usr/bin/env bash
# Local: documentation site. Cloud: prints the unvalidated apply path and exits.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

if [[ "${1:-local}" == "cloud" ]]; then
  echo "Cloud path is not implemented as a safe one-liner."
  echo "The Terraform is an unvalidated skeleton. See docs/aws-kit-gaps.md."
  echo "If you still intend a disposable lab after closing those gaps:"
  echo "  cd terraform/l1/aws && terraform init && terraform plan"
  echo "Do not apply from this repo until the gap list is empty or accepted."
  exit 1
fi

echo "Starting Northstar local console on :43127"
exec npm run dev
