#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/lib.sh"
echo "Initiating Validator 4 registration (initiate -> P-Chain -> complete)"
if need_jq; then
  act add-validator | jq '{event: .state.events[0], validators: [.state.validators[] | {name,status}]}'
else
  act add-validator
fi
echo "Poll ./scripts/health until Validator 4 is healthy."
