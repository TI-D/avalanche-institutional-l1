#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/lib.sh"
need_cli
echo "Restart the same process with the same staking TLS and BLS files."
echo "avalanche network start will bring the local snapshot back if you stopped the whole network."
echo "If you killed one process, start that AvalancheGo with the original --data-dir."
echo "Success: NodeID unchanged, last accepted height catching up."
avalanche network start || true
avalanche network status
