#!/usr/bin/env bash
# Stage 2 failure drill. Kill a local AvalancheGo pid. Do not remove it from ValidatorManager.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
need_cli
index="${1:-2}"
echo "This script does not guess pids. Fence the old process, then stop it yourself."
echo "1. Identify the AvalancheGo process for validator $index."
echo "2. Fence it so the same NodeID cannot return twice."
echo "3. Stop only that process. Do not call removeValidator."
echo "4. This topology is 1-of-1 per L1. Killing the Northstar validator stalls that L1. Settlement can still answer."
if ! pgrep -af avalanchego; then
  echo "No avalanchego process is running. Nothing to kill." >&2
  exit 1
fi
