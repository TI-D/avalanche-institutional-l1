#!/usr/bin/env bash
# Stage 2: deploy both L1s to the local Avalanche network and start the relayer.
set -euo pipefail
source "$(dirname "$0")/lib.sh"
need_cli

avalanche blockchain deploy "$northstar" --local --ewoq --skip-update-check
avalanche blockchain deploy "$settlement" --local --ewoq --skip-update-check
if ! avalanche interchain relayer start --local --skip-update-check; then
  echo "Relayer start returned non-zero. If it is already running from ICM deploy, that is expected."
fi
avalanche network status

echo "Local Primary Network + Northstar + Settlement are up."
echo "Next: ./scripts/local/deploy-contracts"
