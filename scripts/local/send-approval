#!/usr/bin/env bash
# Stage 2: send AssetApproved { assetId: 82731 } Northstar -> Settlement.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

if ! command -v cast >/dev/null 2>&1; then
  echo "cast is required."
  exit 1
fi

# shellcheck disable=SC1091
source "$ROOT/.data/local-contracts.env"

cast send "${REGISTRY:?}" "registerAsset(uint256,string)" 82731 "NSTAR-NOTE" \
  --rpc-url "${NORTHSTAR_RPC:?}" --private-key "${ADMIN_KEY:?}"
cast send "$REGISTRY" "setApproval(uint256,bool)" 82731 true \
  --rpc-url "$NORTHSTAR_RPC" --private-key "$ADMIN_KEY"

echo "Waiting for ApprovalReceived on Settlement. A printed send is not delivery."
deadline=$((SECONDS + 120))
found=0
while [[ $SECONDS -lt $deadline ]]; do
  if cast logs --rpc-url "${SETTLEMENT_RPC:?}" --address "${RECEIVER:?}" --from-block 0 2>/dev/null | grep -q .; then
    found=1
    break
  fi
  sleep 2
done
if [[ "$found" -ne 1 ]]; then
  echo "No Settlement logs from $RECEIVER within 120s. Relayer or authorization failed." >&2
  exit 1
fi
cast logs --rpc-url "$SETTLEMENT_RPC" --address "$RECEIVER" --from-block 0

